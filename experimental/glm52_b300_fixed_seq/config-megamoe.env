# Source config.env first, then this next-run MegaMoE overlay.
# PR #39210 validation completed; user authorized a fresh MegaMoE-only sweep.
# Latest CUDA 13 dev nightly with linux/amd64 support, checked 2026-09-21 UTC.
# Pin the amd64 manifest; newer nightly-cu134-20260920-efa7be2 is arm64-only.
export IMAGE=lmsysorg/sglang:nightly-dev-cu13-20260918-20518d85@sha256:b518f4f8cd15664cf0f733e9bf4fd2105c9c994882a369b247364394db99f596
export SGLANG_COMMIT=6d8a58f177a1488e10e8567a3fa4b4fccd0a26e2
# Supply fresh SGLANG_SOURCE_ROOT, FLASHINFER_SOURCE_ROOT and MEGAMOE_CACHE_ROOT
# explicitly at launch; preserve the original measured runs and their caches.
export SGLANG_FLASHINFER_AUTOTUNE_CACHE=1
export FLASHINFER_COMMIT=ad0a5e5e78e57070ec7c582efe733cb55cd8839f
export FLASHINFER_CUDA_ARCH_LIST=10.3a
export PARALLEL_TOPOLOGY=dp-ep
export PREFILL_CUDA_GRAPH_POLICY=disabled
export RUN_MEGAMOE=true

# Reserve runtime workspace for native BF16 TRT-LLM MTP prefill.
export MEM_FRACTION_STATIC=0.80
# Exercise the previously failing memory peak first; retain all 16 points.
export SWEEP_CASES="4:256 4:4 4:8 4:16 4:32 4:64 4:128 8:4"
