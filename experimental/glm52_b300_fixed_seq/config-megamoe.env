# Source config.env first, then this optimized MegaMoE overlay.
# Supply FLASHINFER_SOURCE_ROOT and MEGAMOE_CACHE_ROOT explicitly at launch.
export FLASHINFER_COMMIT=ad0a5e5e78e57070ec7c582efe733cb55cd8839f
export FLASHINFER_CUDA_ARCH_LIST=10.3a
export PARALLEL_TOPOLOGY=dp-ep
export PREFILL_CUDA_GRAPH_POLICY=disabled
export RUN_MEGAMOE=true

# Reserve runtime workspace for native BF16 TRT-LLM MTP prefill.
export MEM_FRACTION_STATIC=0.80
# Exercise the previously failing memory peak first; retain all 16 points.
export SWEEP_CASES="4:256 4:4 4:8 4:16 4:32 4:64 4:128 8:4"
