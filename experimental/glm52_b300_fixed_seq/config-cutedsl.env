export FLASHINFER_CUDA_ARCH_LIST=10.3a
export FLASHINFER_EXPECTED_VERSION=0.7.0
export CUTE_DSL_EXPECTED_VERSION=4.7.1
export PARALLEL_TOPOLOGY=dp-ep
export PREFILL_CUDA_GRAPH_POLICY=disabled
export MEM_FRACTION_STATIC=0.80
export SWEEP_CASES='4:256 4:4 4:8 4:16 4:32 4:64 4:128 8:4'
export RUN_CUTEDSL=true
